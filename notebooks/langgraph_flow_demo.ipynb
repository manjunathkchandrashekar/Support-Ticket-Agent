import os
import sys

sys.path.insert(0, os.path.abspath(".."))

from dotenv import load_dotenv
load_dotenv("../.env")

from src.graph.support_graph import build_support_graph
from src.utils.helpers import load_json
from src.utils.schemas import Ticket

graph = build_support_graph()
tickets = [Ticket (**t) for t in load_json("../data/tickets/sample_ticket_batch.json")] 
print(f"Loaded {len(tickets)} tickets")


for ticket in tickets:
    final_state = graph.invoke(("ticket": ticket))
    route = final_state["route_decision"]